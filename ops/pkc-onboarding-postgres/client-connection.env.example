# Non-secret contract only. Resolve these two values at runtime from the
# role-specific protected secret root; never commit concrete paths or passwords.
# Required authority: PostgreSQL role ROLE_NAME at private DNS pkc-postgres, port
# 5432, database pkc_founder_mfa, strict verify-full mode, and absolute role-local
# CA, client certificate, private key, and PGPASS paths under /run/secrets/.
PKC_DATABASE_URL=<provided-by-secret-manager>
PGPASSFILE=${PKC_ROLE_PGPASSFILE}

# Instantiate a separate credential set for each authority. Never reuse a
# certificate, private key, password, or PGPASSFILE across these roles:
# pkc_bootstrap_admin
# pkc_backup_reader
# pkc_mfa_migrator
# pkc_mfa_verifier
# pkc_onboarding_runtime
# pkc_onboarding_email_worker
# pkc_onboarding_email_reconciler
