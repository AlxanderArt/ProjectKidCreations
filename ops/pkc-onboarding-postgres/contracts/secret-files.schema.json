{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pkc-onboarding-postgres-secret-files-v1",
  "title": "Closed PostgreSQL server secret filename contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bootstrap_auth_file",
    "tls_server_certificate",
    "tls_server_key",
    "tls_server_ca",
    "tls_client_ca"
  ],
  "properties": {
    "bootstrap_auth_file": { "const": "protected-file" },
    "tls_server_certificate": { "const": "protected-file" },
    "tls_server_key": { "const": "protected-file" },
    "tls_server_ca": { "const": "protected-file" },
    "tls_client_ca": { "const": "protected-file" }
  }
}
