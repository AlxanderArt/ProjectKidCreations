{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pkc-onboarding-postgres-client-secret-files-v1",
  "title": "Closed per-role PostgreSQL client secret contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "ca_file", "certificate_file", "key_file", "pgpass_file"],
  "properties": {
    "role": {
      "enum": [
        "pkc_bootstrap_admin",
        "pkc_backup_reader",
        "pkc_mfa_migrator",
        "pkc_mfa_verifier",
        "pkc_onboarding_runtime",
        "pkc_onboarding_email_worker",
        "pkc_onboarding_email_reconciler"
      ]
    },
    "ca_file": { "const": "protected-file" },
    "certificate_file": { "const": "protected-file" },
    "key_file": { "const": "protected-file" },
    "pgpass_file": { "const": "protected-file" }
  }
}
