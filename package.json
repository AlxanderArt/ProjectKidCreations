{
  "name": "project-kid-creations",
  "version": "1.0.0",
  "description": "ProjectKidCreations — tactical 3D-printed gel-blaster mods. Onboarding pipeline + product surfaces.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server ${PORT:-8765} --bind 127.0.0.1",
    "build": "node scripts/build.mjs",
    "audit:boot-performance": "node scripts/audit-boot-performance.mjs",
    "test:contracts": "node --test tests/contracts/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop-chromium",
    "test:e2e:mobile": "playwright test --project=mobile-webkit",
    "test:e2e:live": "playwright test --config=playwright.config.mjs",
    "vercel-build": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlxanderArt/ProjectKidCreations.git"
  },
  "license": "ISC",
  "dependencies": {
    "gsap": "3.15.0",
    "pg": "8.16.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.25.12"
  }
}
